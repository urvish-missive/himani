rules_version = '2';

// Deploy with: firebase deploy --only storage
// (or paste into Firebase console > Storage > Rules)
service firebase.storage {
  match /b/{bucket}/o {

    // Images pulled out of bulk-uploaded Word documents. Anyone can view them
    // (they appear in public posts); only admins listed in Firestore /admins can upload.
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
